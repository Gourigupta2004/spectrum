# Copy to .env and fill in. Every setting is read from the environment.

DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.spectrum.in
# this backend's public origin
API_URL=https://api.spectrum.in
# the website's origin (download links, CORS)
SITE_URL=https://spectrum.in
CORS_ALLOWED_ORIGINS=https://spectrum.in
CSRF_TRUSTED_ORIGINS=https://api.spectrum.in

# Database: SQLite (set above) uses the least memory. For Postgres instead:
# DATABASE_URL=postgres://spectrum:password@127.0.0.1:5432/spectrum

# Storage. Off = files on this server's disk (served by nginx).
# Keep media and the database OUTSIDE the code folder so redeploying code can never delete them.
USE_S3=0
MEDIA_ROOT=/srv/spectrum/media
DATABASE_URL=sqlite:////srv/spectrum/data/db.sqlite3
WORK_DIR=/srv/spectrum/tmp
CACHE_DIR=/srv/spectrum/cache
# AWS_STORAGE_BUCKET_NAME=spectrum-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=cdn.spectrum.in   # optional CloudFront domain for public images
# AWS_S3_ENDPOINT_URL=                    # only for S3-compatible stores such as Cloudflare R2

# Razorpay (dashboard > Settings > API keys and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 1 = fake payments for demos, never in production
PAYMENTS_MOCK=0

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=+14155238886
# approved template with {{1}} event, {{2}} count, {{3}} link
TWILIO_CONTENT_SID=

# Email
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Spectrum <support@spectrum.in>
ENQUIRY_NOTIFY_EMAILS=support@spectrum.in

# Background jobs run in `manage.py runworker`. Set to 1 only for local development.
TASKS_EAGER=0
